[Unit]
Description=Chemie-Lernen Express Chat API
After=network-online.target docker.service chemie-neo4j.service
Wants=network-online.target
Requires=chemie-neo4j.service
Documentation=https://chemie-lernen.org

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chemie-lernen-org
ExecStartPre=/usr/bin/docker pull registry.chemie-lernen.org/chemie-chat-api:latest
ExecStart=/usr/bin/docker compose -f /opt/chemie-lernen-org/docker-compose.yml up --no-deps chemie-chat-api
ExecStop=/usr/bin/docker compose -f /opt/chemie-lernen-org/docker-compose.yml stop chemie-chat-api
ExecStopPost=/usr/bin/docker compose -f /opt/chemie-lernen-org/docker-compose.yml rm -f chemie-chat-api
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
