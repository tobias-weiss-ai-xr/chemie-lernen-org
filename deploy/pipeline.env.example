# Template for /opt/litellm/pipeline.env (referenced by
# deploy/systemd/chemie-article-pipeline.service EnvironmentFile).
# Copy real values from the server's existing pipeline.env — do NOT commit
# real keys to git.
#
# LiteLLM proxy (litellm-proxy container, bound to 127.0.0.1:4000)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-<virtual-key-from-litellm-key-generate>
# Model used by scripts/article-pipeline.mjs (must exist in LiteLLM
# config.yaml). glm-5.2 works reliably; saia/* models are quota-limited.
LITELLM_MODEL=glm-5.2

# Neo4j (chemie-neo4j container). Note: the code reads NEO4J_USER
# (not NEO4J_USERNAME). Password must match the server repo's .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<same-as-/opt/git/hugo-chemie-lernen-org/.env NEO4J_PASSWORD>
NEO4J_DATABASE=chemie
