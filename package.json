{
  "scripts": {
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathIgnorePatterns='(complete-site-audit|site-accessibility|mobile-responsiveness|accessibility-validation)'",
    "test:all": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathIgnorePatterns='(complete-site-audit|site-accessibility|mobile-responsiveness|accessibility-validation)' --verbose",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage --forceExit",
    "test:verbose": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --verbose --forceExit",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathPattern='(complete-site-audit|site-accessibility|mobile-responsiveness|accessibility-validation|visualization)'",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathIgnorePatterns='(complete-site-audit|site-accessibility|mobile-responsiveness|accessibility-validation|visualization)'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:calculators": "eslint myhugoapp/static/js/calculators/",
    "lint:tests": "eslint tests/",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,html,css}\"",
    "validate": "npm run lint && npm run format:check && npm run test:unit && npm run duplicate:check && npm run hugo:build",
    "prepare": "husky",
    "minify": "node scripts/minify-calculators.js",
    "analyze:performance": "node scripts/analyze-bundle.js",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "performance:check": "node scripts/analyze-bundle.js",
    "optimize": "npm run minify && npm run performance:check",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:dev": "npm audit --audit-level=moderate --only=dev",
    "check:updates": "npm outdated",
    "update:dependencies": "npm update",
    "security:check": "npm run audit && npm run check:updates",
    "duplicate:check": "jscpd myhugoapp/static/js --min-lines=10 --min-tokens=50 --threshold=10 --gitignore",
    "hugo:build": "docker run --rm -v \"$(pwd)/myhugoapp:/src\" -w /src hugomods/hugo:exts hugo",
    "export:kg-data": "node scripts/export-kg-data.mjs",
    "generate:entities": "node scripts/generate-entity-pages.mjs",
    "validate:curricula": "node scripts/validate-curricula.mjs",
    "scrape:modulhandbuch": "node scripts/modulhandbuch/_run-all.mjs",
    "import:modulhandbuch": "node scripts/import-modulhandbuch.mjs",
    "prebuild": "(node scripts/export-kg-data.mjs || echo '[build] Neo4j export skipped (non-fatal)') && node scripts/generate-entity-pages.mjs && (node scripts/build-search-index.mjs || echo '[build] Search index skipped (kg_data empty)')",
    "build": "docker run --rm -v \"$(pwd)/myhugoapp:/src\" -w /src hugomods/hugo:exts hugo --baseURL https://chemie-lernen.org && npx pagefind --site myhugoapp/public",
    "dev": "echo 'Starting API and Hugo dev server... Ensure docker compose is running for the API.' && (hugo server -D --source myhugoapp --disableFastRender &) && sleep 2 && echo 'Hugo dev server started on http://localhost:1313' && wait",
    "dev:api": "docker compose up -d chemie-chat-api && docker compose logs -f chemie-chat-api",
    "lighthouse": "lhci autorun --upload=false --collect.numberOfRuns=3 --collect.settings.chromeFlags=\"--no-sandbox\"",
    "audit:mobile": "node scripts/mobile-ux-audit.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,jsx,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@graphwiz/builder": "file:packages/graphwiz/graphwiz-builder-0.2.0.tgz",
    "@graphwiz/core": "file:packages/graphwiz/graphwiz-core-0.2.0.tgz",
    "@graphwiz/neo4j": "file:packages/graphwiz/graphwiz-neo4j-0.2.0.tgz",
    "@playwright/test": "^1.61.0",
    "fast-xml-parser": "^5.9.2",
    "lunr": "2.3.9",
    "neo4j-driver": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/jest": "^29.5.12",
    "axe-core": "^4.12.1",
    "axios": "^1.13.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscpd": "^5.0.11",
    "lint-staged": "^16.2.7",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.5",
    "terser": "^5.48.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "myhugoapp/static/js/calculators/**/*.js",
      "myhugoapp/static/js/utils/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.optimized\\.js$",
      "\\.min\\.js$"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(three|three-orbitcontrols|three-js-camera)/)"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
