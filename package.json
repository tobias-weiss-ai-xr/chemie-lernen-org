{
  "scripts": {
    "test": "vitest run --exclude '**/complete-site-audit*' --exclude '**/site-accessibility*' --exclude '**/mobile-responsiveness*' --exclude '**/accessibility-validation*' --exclude '**/.tf-worktrees/**'",
    "test:all": "vitest run --exclude '**/.tf-worktrees/**' --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "vitest run --reporter=verbose",
    "test:integration": "vitest run --testNamePattern='(complete-site-audit|site-accessibility|mobile-responsiveness|accessibility-validation|visualization)'",
    "test:unit": "vitest run --exclude '**/complete-site-audit*' --exclude '**/site-accessibility*' --exclude '**/mobile-responsiveness*' --exclude '**/accessibility-validation*' --exclude '**/visualization*' --exclude '**/.tf-worktrees/**'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:calculators": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathPatterns='(calc-|stoichiometry|molare-masse|advanced-calculators|ph-rechner|dampfdruck|verduennung|konzentrationsumrechner|dichte|druck-flaechen|loeslichkeitsprodukt|chemisches-gleichgewicht|hess-gesetz|reaktionskinetik|redox-potenzial|atmosphaerendruck|bindungspotential)'",
    "test:chemistry": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathPatterns='chemistry-utils'",
    "test:kg": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathPatterns='(neo4j|knowledge-graph|curricula|kg-|entity-index|generate-themenbereich|blooms|api-import|malformed-uri|modulhandbuch)'",
    "test:api": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathPatterns='(auto-grader|exercise-|feedback|learning-|session-store|assessment-|rag|zpd|didaktik|premium-|security-utils|modulhandbuch-api|neo4j-service|theme-overrides|stripe)'",
    "test:ui": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathPatterns='(ui-utils|debug-logger|error-handler|dropdown|export-manager|quiz|practice|lesson-plan|session-plan|adaptive|fsrs|spaced|offline|ki-assistent|d3-ego|tutorials|progress)'",
    "test:hermetic": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --forceExit --testPathIgnorePatterns='(complete-site-audit|site-accessibility|mobile-responsiveness|accessibility-validation|\\.tf-worktrees|\\.test\\.mjs$)'",
    "test:e2e:hubs": "playwright test tests/test-hubs-integration.spec.js",
    "test:e2e:pwa": "playwright test tests/test-pwa-manifest.spec.js",
    "test:e2e:visual": "playwright test test-molecule-studio-visual.spec.js test-green-colors.spec.js",
    "test:e2e:smoke": "playwright test test-pages.features.spec.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:calculators": "eslint myhugoapp/static/js/calculators/",
    "lint:tests": "eslint tests/",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,html,css}\"",
    "validate": "bun run lint && bun run format:check && bun run test:unit && bun run duplicate:check && bun run hugo:build",
    "prepare": "husky",
    "minify": "node scripts/minify-calculators.js",
    "analyze:performance": "node scripts/analyze-bundle.js",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "performance:check": "node scripts/analyze-bundle.js",
    "optimize": "bun run minify && bun run performance:check",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:dev": "npm audit --audit-level=moderate --only=dev",
    "check:updates": "npm outdated",
    "update:dependencies": "npm update",
    "security:check": "bun run audit && bun run check:updates",
    "duplicate:check": "jscpd myhugoapp/static/js --min-lines=10 --min-tokens=50 --threshold=10 --ignore '**/*.optimized.js'",
    "hugo:build": "docker run --rm -v \"$(pwd)/myhugoapp:/src\" -w /src hugomods/hugo:exts hugo",
    "export:kg-data": "node scripts/export-kg-data.mjs",
    "generate:entities": "node scripts/generate-entity-pages.mjs",
    "generate:themenbereich-entities": "node scripts/generate-themenbereich-entities.mjs",
    "validate:curricula": "node scripts/validate-curricula.mjs",
    "scrape:modulhandbuch": "node scripts/modulhandbuch/_run-all.mjs",
    "import:modulhandbuch": "node scripts/import-modulhandbuch.mjs",
    "prebuild": "(node scripts/export-kg-data.mjs || echo '[build] Neo4j export skipped (non-fatal)') && node scripts/generate-entity-pages.mjs && (node scripts/build-search-index.mjs || echo '[build] Search index skipped (kg_data empty)') && (node scripts/fetch-zigs-videos.mjs || echo '[build] Zig video feed skipped (non-fatal)')",
    "fetch:zigs-videos": "node scripts/fetch-zigs-videos.mjs",
    "build": "docker run --rm -v \"$(pwd)/myhugoapp:/src\" -w /src hugomods/hugo:exts hugo --baseURL https://chemie-lernen.org && npx pagefind --site myhugoapp/public",
    "dev": "echo 'Starting API and Hugo dev server... Ensure docker compose is running for the API.' && (hugo server -D --source myhugoapp --disableFastRender &) && sleep 2 && echo 'Hugo dev server started on http://localhost:1313' && wait",
    "dev:api": "docker compose up -d chemie-chat-api && docker compose logs -f chemie-chat-api",
    "lighthouse": "lhci autorun --upload=false --collect.numberOfRuns=3 --collect.settings.chromeFlags=\"--no-sandbox\"",
    "audit:mobile": "node scripts/mobile-ux-audit.js",
    "vendor-core": "bash scripts/vendor-core.sh",
    "pretest": "bash scripts/vendor-core.sh",
    "tf:start": "node scripts/taskfleet.mjs",
    "tf:monitor": "node scripts/taskfleet-monitor.mjs",
    "tf:coordinator": "node scripts/taskfleet-coordinator.mjs",
    "tf:worker": "node scripts/taskfleet-worker.mjs",
    "tf:docker": "bash scripts/taskfleet-docker.sh"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,jsx,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@graphwiz/builder": "file:packages/graphwiz/graphwiz-builder-0.2.0.tgz",
    "@graphwiz/core": "file:packages/graphwiz/graphwiz-core-0.2.0.tgz",
    "@graphwiz/neo4j": "file:packages/graphwiz/graphwiz-neo4j-0.2.0.tgz",
    "@playwright/test": "^1.61.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "fast-xml-parser": "^5.9.2",
    "lunr": "2.3.9",
    "neo4j-driver": "^6.1.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.12.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.1.0",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^8.6.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jscpd": "^5.0.11",
    "jsdom": "26.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.2.7",
    "nodemailer": "^9.0.5",
    "pagefind": "^1.5.2",
    "pdfkit": "^0.20.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.5",
    "stripe": "^22.5.0",
    "terser": "^5.48.0",
    "vitest": "4.1.11"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.mjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.tf-worktrees/",
      "<rootDir>/tests/__flaky__/"
    ],
    "transform": {
      "^.*/api/.*\\.js$": "<rootDir>/jest-transform-esm.cjs",
      "^.+\\.mjs$": "<rootDir>/jest-transform-esm.cjs",
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "collectCoverageFrom": [
      "myhugoapp/static/js/calculators/**/*.js",
      "myhugoapp/static/js/utils/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.optimized\\.js$",
      "\\.min\\.js$",
      "\\.core",
      "__flaky__"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(three|three-orbitcontrols|three-js-camera)/)"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 35,
        "branches": 40,
        "functions": 35,
        "lines": 37
      }
    }
  },
  "packageManager": "bun@1.3.11"
}
