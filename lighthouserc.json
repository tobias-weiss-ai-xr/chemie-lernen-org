{
  "ci": {
    "collect": {
      "url": [
        "https://chemie-lernen.org/",
        "https://chemie-lernen.org/entity/",
        "https://chemie-lernen.org/entity/wasserstoff/",
        "https://chemie-lernen.org/themenbereiche/",
        "https://chemie-lernen.org/ki-assistent/"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.75 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 600 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.25 }],
        "speed-index": ["warn", { "maxNumericValue": 5000 }]
      }
    },
    "upload": {
      "ignoreDestinationError": true
    }
  }
}
