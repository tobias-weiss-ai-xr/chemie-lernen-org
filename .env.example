# ─── Neo4j (chemie database) ────────────────────────────────────────────
# Required for: API server, export-kg-data.mjs, curriculum scrapers
NEO4J_URI=bolt://chemie-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=chemie

# ─── JWT & Auth ─────────────────────────────────────────────────────────
# Required for: API server (auth.js) — sessions, magic links, admin routes
# MUST be a strong random secret (>= 32 chars). Placeholders are REJECTED at boot.
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64

# ─── Stripe (Lehrenden-Premium) ─────────────────────────────────────────
# Required for: API server (auth.js) — subscription management, webhooks
# 
# **Stripe Test Mode Setup:**
# 1. Go to https://dashboard.stripe.com/test/apikeys
# 2. Copy "Secret key" → STRIPE_SECRET_KEY
# 3. Create product & price in Stripe Dashboard (test mode):
#    - Products → Add product (e.g., "Lehrenden Premium")
#    - Add pricing (e.g., €29.99/month)
#    - Copy Price ID → STRIPE_PRICE_ID
# 4. Create checkout session in code → Stripe creates session URL
# 5. For webhooks (local dev):
#    - Install Stripe CLI: `stripe listen --forward-to localhost:3001/api/auth/stripe-webhook`
#    - Copy webhook signing secret → STRIPE_WEBHOOK_SECRET
# 6. For production:
#    - Add webhook endpoint in Stripe Dashboard: https://your-domain.com/api/auth/stripe-webhook
#    - Select events: checkout.session.completed, customer.subscription.*, invoice.payment_failed
#    - Copy webhook signing secret → STRIPE_WEBHOOK_SECRET
# 
# Test cards: https://stripe.com/docs/testing#cards
# - 4242 4242 4242 4242 → Success
# - 4000 0000 0000 9995 → Decline (insufficient funds)
# - 4000 0025 0000 3155 → Requires authentication (3D Secure)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Get from: https://dashboard.stripe.com/test/webhooks (endpoint secret)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# The Stripe Price ID for the premium monthly subscription
STRIPE_PRICE_ID=price_your-price-id

# ─── SMTP (Email — magic links, passwordless login) ─────────────────────
# Required for: API server (auth.js) — sending login emails
# Optional: if not set, login emails will fail silently (see logs)
SMTP_HOST=mail.your-domain.org
SMTP_PORT=587
SMTP_USER=your-smtp-user@domain.org
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=support@chemie-lernen.org

# ─── Frontend URL ───────────────────────────────────────────────────────
# Used for: redirect URLs in auth flows, CORS
FRONTEND_URL=https://chemie-lernen.org

# ─── LiteLLM (KI-Assistent chat) ────────────────────────────────────────
# Required for: API server — proxy chemistry questions to LLM
LITELLM_URL=http://litellm-proxy:4000
LITELLM_MODEL=tud/gemma-4-31b-it
LITELLM_API_KEY=

# ─── Rate Limiting ──────────────────────────────────────────────────────
# Requests per IP per day for the chat endpoint (default: 50)
RATE_LIMIT=50

# ─── RAG (Retrieval-Augmented Generation) ───────────────────────────────
# Set to "false" to disable semantic search from Neo4j (default: enabled)
RAG_SEMANTIC_ENABLED=true

# ─── Grafana ────────────────────────────────────────────────────────────
# Required for: Grafana service login
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password-here

# ─── Sentry (Error Tracking) ────────────────────────────────────────────
# Optional: if not set, Sentry is disabled entirely
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ─── Healthchecks.io (Cron Monitoring) ──────────────────────────────────
# Optional: ping URL for scheduled task monitoring
HEALTHCHECKS_IO_URL=https://hc-ping.com/your-uuid

# ─── Admin API Key ──────────────────────────────────────────────────────
# Optional: if set, /api/admin/* routes require this key via X-API-Key header
ADMIN_API_KEY=

# ─── Export Script Limits ───────────────────────────────────────────────
# Optional overrides for scripts/export-kg-data.mjs
# LIMIT_ENTITIES=5000
# LIMIT_ARTICLES=10000
# LIMIT_CURRICULA=5000
# MAX_ARTICLES_PER_ENTITY=20

# ─── Hugo / Domain ─────────────────────────────────────────────────────
# Domain for the production site (used in build scripts, sitemaps, etc.)
HUGO_DOMAIN=chemie-lernen.org

# ─── Off-site Backup (restic) ────────────────────────────────────────────
# Optional: restic repository URL and password for encrypted off-site backups.
# Examples: s3:https://s3.eu-central-1.amazonaws.com/<bucket>/<path>
#           rclone:<remote>:<path>
#           /opt/restic-repo (local — for testing)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# ─── Logging ────────────────────────────────────────────────────────────
# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info
