# ════════════════════════════════════════════════════════════════════
# chemie-lernen.org — Required Environment Variables
# ════════════════════════════════════════════════════════════════════
# Copy this to `.env` (gitignored) and fill in real values.
#   cp .env.example .env && vim .env
# ════════════════════════════════════════════════════════════════════

# ── Neo4j ──────────────────────────────────────────────────────────
NEO4J_PASSWORD=change_me_32_char_random_string

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_64_hex_chars_0123456789abcdef0123456789abcdef

# ── SMTP (mail.tobias-weiss.org) ───────────────────────────────────
SMTP_HOST=mail.tobias-weiss.org
SMTP_PORT=587
SMTP_USER=chemie@tobias-weiss.org
SMTP_PASSWORD=change_me
EMAIL_FROM=support@chemie-lernen.org

# ── Stripe (premium payments) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ── Monitoring ─────────────────────────────────────────────────────
SENTRY_DSN=https://xxx@oxxx.ingest.us.sentry.io/xxx
HEALTHCHECKS_IO_URL=https://hc-ping.com/xxx

# ── Grafana ────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me

# ── Off-site Backup (restic) ──────────────────────────────────────
# Restic repository URL and password for encrypted off-site backups.
# Examples: s3:https://s3.eu-central-1.amazonaws.com/<bucket>/<path>
#           rclone:<remote>:<path>
#           /opt/restic-repo (local — for testing)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# RESTIC_HOST=  # Uncomment to override the hostname tag

# ── Hugo (domain for the site) ─────────────────────────────────────
HUGO_DOMAIN=chemie-lernen.org
